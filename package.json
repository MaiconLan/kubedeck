{
  "name": "kubedeck",
  "version": "0.1.0",
  "description": "Local, visual Kubernetes dashboard that drives kubectl and helm.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "kubedeck": "bin/kubedeck.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "start": "node bin/kubedeck.js",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dev:server": "tsx watch server/cli.ts --dev",
    "dev:web": "vite",
    "dev:desktop": "npm run build:node && electron . --dev",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/geist": "^5.1.0",
    "@fontsource/geist-mono": "^5.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "author": "KubeDeck",
  "main": "dist/desktop/main.js",
  "build": {
    "appId": "dev.kubedeck.app",
    "productName": "KubeDeck",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
